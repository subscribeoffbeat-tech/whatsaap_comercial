package templates

import (
	"fmt"
	"whatsapptool/internal/db"
	mw "whatsapptool/internal/web/middleware"
)

templ NewContactPage(agent *mw.AgentClaims, tags []db.Tag, errMsg string) {
	@templ.Raw(ShellOpen(agent, "/contacts", "New Contact", ""))
	<div class="page-wrap nc-pg" x-data="ncApp()">
		if errMsg != "" {
			@templ.Raw(FormBanner(errMsg))
		}
		<div class="nc-hd">
			@Button(BtnGhost, BtnMd, "/contacts", ncChevronLeftSVG, "", templ.Attributes{"aria-label": "Back to contacts"})
			<div>
				<div class="screen-title">New Contact</div>
				<div class="screen-subtitle">Add a contact to your directory</div>
			</div>
		</div>
		<div class="nc-body">
			<div class="card nc-form-card">
				<form method="POST" action="/contacts/new">
					<div class="nc-row">
						<div class="form-group">
							<label class="form-label">Full name <span class="nc-req">*</span></label>
							<input class="form-input" type="text" name="name" x-model="name" placeholder="Priya Sharma" required autocomplete="off"/>
						</div>
						<div class="form-group">
							<label class="form-label">WhatsApp number <span class="nc-req">*</span></label>
							<input class="form-input" type="tel" name="phone" x-model="phone" placeholder="+91 98765 43210" required/>
						</div>
					</div>
					<div class="nc-row">
						<div class="form-group">
							<label class="form-label">Email <span class="nc-opt">(optional)</span></label>
							<input class="form-input" type="email" name="email" placeholder="priya@example.com"/>
						</div>
						<div class="form-group">
							<label class="form-label">City <span class="nc-opt">(optional)</span></label>
							<select class="form-input" name="city" x-model="city">
								<option value="">Select city...</option>
								for _, c := range indianCities {
									<option value={ c }>{ c }</option>
								}
							</select>
						</div>
					</div>
					<div class="form-group">
						<label class="form-label">Tags <span class="nc-opt">(optional)</span></label>
						<!-- Selected tags (existing + custom) as removable chips -->
						<div class="nc-tag-pills" style="margin-bottom:8px">
							<template x-for="t in tags" :key="t">
								<span class="tag-pill tag-pill--on" style="display:inline-flex;align-items:center;gap:5px">
									<span x-text="t"></span>
									<button type="button" @click="removeTag(t)" aria-label="Remove tag" style="border:none;background:none;cursor:pointer;font-size:15px;line-height:1;color:inherit">&times;</button>
								</span>
							</template>
							<span x-show="tags.length===0" style="color:var(--text-secondary);font-size:13px">No tags selected</span>
						</div>
						<!-- Type a custom tag and press Enter to add it (created automatically on save) -->
						<input class="form-input" type="text" x-model="tagInput"
							placeholder="Type a tag and press Enter"
							@keydown.enter.prevent="addTag(tagInput); tagInput=''"
							autocomplete="off"/>
						if len(tags) > 0 {
							<div class="nc-tag-pills" style="margin-top:8px">
								<span style="color:var(--text-secondary);font-size:12px;width:100%">Quick-pick existing:</span>
								for _, t := range tags {
									@TagPill(TagToggle, t.Name, TagColorDefault, false, templ.Attributes{
										":class": fmt.Sprintf("{'tag-pill--on':tags.includes('%s')}", jsStr(t.Name)),
										"@click": fmt.Sprintf("toggleTag('%s')", jsStr(t.Name)),
									})
								}
							</div>
						}
						<input type="hidden" name="tags" :value="tags.join(',')"/>
					</div>
					<label class="nc-consent-row">
						<div>
							<div class="nc-consent-title">Marketing consent</div>
							<div class="nc-consent-desc">Contact has opted in to receive WhatsApp messages</div>
						</div>
						@Toggle("opt_in", true, templ.Attributes{"value": "on", "x-model": "optedIn"})
					</label>
					<div class="form-group" style="margin-top:20px">
						<label class="form-label">Notes <span class="nc-opt">(optional)</span></label>
						<textarea class="form-input nc-notes" name="notes" placeholder="Internal notes about this contact..." rows="4"></textarea>
					</div>
					<div class="nc-footer">
						@Button(BtnSecondary, BtnMd, "/contacts", "", "Cancel", nil)
						@Button(BtnPrimary, BtnMd, "", "", "Save contact", templ.Attributes{
							"type":      "submit",
							":disabled": "!name.trim() || phone.trim().length < 5",
							":class":    "{'btn-disabled':!name.trim() || phone.trim().length < 5}",
						})
					</div>
				</form>
			</div>
			<div class="nc-preview-card">
				<div class="nc-preview-label">CONTACT PREVIEW</div>
				<div class="nc-preview-body">
					<div class="nc-preview-av" x-text="initials"></div>
					<div>
						<div class="nc-preview-name" x-text="name.trim() || 'Full name'"></div>
						<div class="nc-preview-city" x-text="city || 'City'"></div>
					</div>
				</div>
				<div class="nc-preview-phone" x-text="phone || '+91'"></div>
				<div class="nc-preview-consent">
					<span class="consent-dot" :class="optedIn ? 'consent-dot--in' : 'consent-dot--out'"></span>
					<span x-text="optedIn ? 'Opted in' : 'Opted out'" :style="optedIn ? 'color:var(--accent)' : 'color:var(--danger)'"></span>
				</div>
			</div>
		</div>
	</div>
	<script>
	function ncApp() {
	  return {
	    name: '',
	    phone: '+91',
	    city: '',
	    optedIn: true,
	    tags: [],
	    tagInput: '',
	    get initials() {
	      const p = this.name.trim().split(/\s+/).filter(Boolean);
	      if (!p.length) return '?';
	      let i = p[0].charAt(0);
	      if (p.length > 1) i += p[p.length-1].charAt(0);
	      return i.toUpperCase();
	    },
	    toggleTag(n) {
	      const i = this.tags.indexOf(n);
	      if (i >= 0) this.tags.splice(i,1); else this.tags.push(n);
	    },
	    addTag(raw) {
	      const n = (raw || '').trim().replace(/,+$/, '').trim();
	      if (n && !this.tags.some(t => t.toLowerCase() === n.toLowerCase())) this.tags.push(n);
	    },
	    removeTag(n) {
	      this.tags = this.tags.filter(t => t !== n);
	    }
	  };
	}
	</script>
	@templ.Raw(ShellClose())
}
