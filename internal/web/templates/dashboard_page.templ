package templates

import (
	"fmt"
	"strconv"

	"whatsapptool/internal/db"
	mw "whatsapptool/internal/web/middleware"
)

// DashboardPage pre-computes display values and delegates to the inner templ component.
// Signature matches the former ComponentFunc wrapper — dashboard.go is unchanged.
func DashboardPage(agent *mw.AgentClaims, stats db.DashboardStats, recent []db.Campaign) templ.Component {
	dotClass, qualityLabel, qualityUnknown := dashQualityAttrs(stats.QualityRating)
	capPct, fillClass := dashCapPct(stats.CapUsedToday, stats.DailyCap)
	isAgent := agent != nil && agent.Role == "agent"
	return dashboardPageInner(agent, stats, recent, dotClass, qualityLabel, qualityUnknown, capPct, fillClass, isAgent)
}

func dashQualityAttrs(qr string) (dotClass, label string, unknown bool) {
	switch qr {
	case "yellow":
		return "quality-yellow", "Medium", false
	case "red":
		return "quality-red", "Low", false
	case "unknown":
		return "", "Unknown", true
	default:
		return "quality-green", "High", false
	}
}

func dashCapPct(used, cap int64) (pct int, fillClass string) {
	if cap > 0 {
		pct = int(used * 100 / cap)
		if pct > 100 {
			pct = 100
		}
	}
	fillClass = "tier-bar-fill"
	if pct >= 90 {
		fillClass = "tier-bar-fill tier-bar-fill--warn"
	}
	return pct, fillClass
}

templ dashboardPageInner(agent *mw.AgentClaims, stats db.DashboardStats, recent []db.Campaign, qualityDotClass string, qualityLabel string, qualityUnknown bool, capPct int, fillClass string, isAgent bool) {
	@templ.Raw(ShellOpen(agent, "/", "Dashboard", ""))
	<div class="page-wrap">
		<div class="page-hd">
			<div>
				<h1 class="screen-title">Dashboard</h1>
				<p class="screen-subtitle">Overview of your WhatsApp channel</p>
			</div>
		</div>
		if stats.QualityRating == "red" {
			@templ.Raw(CalloutHTML("danger", "Your WhatsApp phone quality is low. Sending may be restricted by Meta."))
		} else if stats.QualityRating == "yellow" {
			@templ.Raw(CalloutHTML("warning", "Your WhatsApp phone quality has dropped. Review your messaging to avoid sending restrictions."))
		}
		<!-- Quick action tiles (top, for fast access). These all lead to
		     Manager+ pages, so hide them from agents to avoid 403 dead-ends. -->
		if !isAgent {
			<div class="qa-grid">
			<a class="qa-tile" href="/campaigns/new">
				<span class="qa-ico qa-ico--violet">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
				</span>
				<span class="qa-label">New campaign</span>
			</a>
			<a class="qa-tile" href="/contacts/new">
				<span class="qa-ico qa-ico--blue">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
				</span>
				<span class="qa-label">Add contact</span>
			</a>
			<a class="qa-tile" href="/contacts/import">
				<span class="qa-ico qa-ico--green">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
				</span>
				<span class="qa-label">Import CSV</span>
			</a>
			<a class="qa-tile" href="/templates/new">
				<span class="qa-ico qa-ico--amber">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
				</span>
				<span class="qa-label">New template</span>
			</a>
			if !isAgent {
				<a class="qa-tile" href="/automation">
					<span class="qa-ico qa-ico--pink">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
					</span>
					<span class="qa-label">New automation</span>
				</a>
			}
		</div>
		}
		<!-- 4 stat cards -->
		<div class="stat-grid">
			<div class="stat-card">
				<div class="stat-label">Sent today</div>
				<div class="stat-value">{ strconv.FormatInt(stats.SentToday, 10) }</div>
				<div class="stat-sub">messages dispatched</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Delivered</div>
				<div class="stat-value">{ strconv.FormatInt(stats.DeliveredToday, 10) }</div>
				<div class="stat-sub">confirmed by Meta</div>
			</div>
			<a href="/inbox" class="stat-card stat-card--link">
				<div class="stat-label">Chats waiting</div>
				<div class="stat-value">{ strconv.FormatInt(stats.ChatsWaiting, 10) }</div>
				<div class="stat-sub">open conversations</div>
			</a>
			if !isAgent {
				<div class="stat-card">
					<div class="stat-label">Cost this month</div>
					<div class="stat-value">&#8377;{ fmt.Sprintf("%.2f", stats.CostThisMonth) }</div>
					<div class="stat-sub">incl. 18% GST</div>
				</div>
			}
		</div>
		<!-- Channel health: capacity bar + quality side by side -->
		<div class="dash-health-row">
			<div class="card-static dash-cap-card">
				<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
					<div style="font-size:15px;font-weight:600;color:var(--text-strong)">Daily send capacity</div>
					<div style="font-size:13px;color:var(--text-secondary)">{ strconv.FormatInt(stats.CapUsedToday, 10) } / { strconv.FormatInt(stats.DailyCap, 10) } messages</div>
				</div>
				<div
					class="tier-bar-wrap"
					role="progressbar"
					aria-valuenow={ strconv.FormatInt(stats.CapUsedToday, 10) }
					aria-valuemin="0"
					aria-valuemax={ strconv.FormatInt(stats.DailyCap, 10) }
					aria-label={ fmt.Sprintf("Daily send capacity: %d of %d messages used", stats.CapUsedToday, stats.DailyCap) }
				>
					<div class={ fillClass } style={ fmt.Sprintf("width:%d%%", capPct) }></div>
				</div>
				<div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-muted);margin-top:6px">
					<span>{ strconv.FormatInt(stats.CapUsedToday, 10) } used</span>
					<span>{ fmt.Sprintf("%d%%", capPct) }</span>
					<span>{ strconv.FormatInt(stats.DailyCap, 10) } cap</span>
				</div>
			</div>
			<div class="card-static dash-quality-card">
				<div style="font-size:13px;color:var(--text-secondary);margin-bottom:8px">Phone quality</div>
				<div style="display:flex;align-items:center;gap:0.5rem;font-size:1.6rem;font-weight:700;color:var(--text-strong)">
					if !qualityUnknown {
						<span class={ "quality-dot " + qualityDotClass } style="width:14px;height:14px;flex-shrink:0"></span>
					}
					{ qualityLabel }
				</div>
				<div style="font-size:12px;color:var(--text-muted);margin-top:6px">Meta phone rating</div>
			</div>
		</div>
		<!-- Recent campaigns (full width) -->
		<div class="card-static">
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
				<h2 style="margin:0;font-size:15px;font-weight:600;color:var(--text-strong)">Recent campaigns</h2>
				<a class="btn btn-secondary btn-sm" href="/campaigns">View all</a>
			</div>
			if len(recent) == 0 {
				@templ.Raw(EmptyStateHTML(EmptyIconCampaigns, "No campaigns yet", "Launch your first broadcast to get started.", []EmptyAction{{Label: "New campaign", Primary: true, HREF: "/campaigns/new"}}))
			} else {
				<table class="an-table tbl">
					<thead>
						<tr>
							<th scope="col">CAMPAIGN</th>
							<th scope="col">STATUS</th>
							<th scope="col">SENT</th>
							<th scope="col">DELIVERED</th>
							<th scope="col">FAILED</th>
							if !isAgent {
								<th scope="col">COST</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, c := range recent {
							<tr>
								<td><a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/report", c.ID)) } style="font-weight:500">{ c.Name }</a></td>
								<td>@templ.Raw(BadgeHTML(c.Status, c.Status))</td>
								<td>{ strconv.Itoa(c.SentCount) }</td>
								<td>{ strconv.Itoa(c.DeliveredCount) }</td>
								<td>{ strconv.Itoa(c.FailedCount) }</td>
								if !isAgent {
									<td>&#8377;{ fmt.Sprintf("%.2f", c.CostTotalINR) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
	@templ.Raw(ShellClose())
}
